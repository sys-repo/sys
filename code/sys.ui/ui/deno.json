{
  "name": "@sys/ui",
  "version": "0.0.53",
  "license": "MIT",
  "tasks": {
    "test": "deno test -P=test",
    "test:passkey:browser": "deno run --frozen --cached-only --no-prompt -P=passkey-browser-launch ./-scripts/task.passkey.browser.ts",
    "dev": "deno run --unstable-no-legacy-abort -A ./-scripts/task.cell.ts --mode dev --reporter auto",
    "build": "deno run -A ./-scripts/task.vite.ts --cmd=build --in=./src/index.html",
    "serve": "deno run --unstable-no-legacy-abort -P=dev ./-scripts/task.cell.ts --reporter auto",
    "kill": "deno task kill:dev && deno task kill:serve",
    "kill:dev": "deno run -P=dev @sys/cell kill . --mode dev",
    "kill:serve": "deno run -P=dev @sys/cell kill . --mode default",
    "dry": "deno publish --allow-dirty --dry-run",
    "check": "deno check -- ./src/ ./-sample/* ./-scripts/*",
    "clean": "deno run -P=clean ./-scripts/task.clean.ts",
    "info": "deno run -A ./-scripts/task.vite.ts --cmd=info",
    "tmp": "deno run -A ./-scripts/task.tmp.ts"
  },
  "publish": {
    "exclude": [
      "-sample/"
    ]
  },
  "exports": {
    ".": "./src/mod.ts",
    "./t": "./src/types.ts",
    "./react/t": "./src/ui.react/t.ts",
    "./react/files": "./src/ui.react/ui.files/mod.ts"
  },
  "permissions": {
    "clean": {
      "read": true,
      "write": true,
      "env": true
    },
    "test": {
      "read": true,
      "write": true,
      "env": true
    },
    "passkey-browser-launch": {
      "read": true,
      "write": [
        "./.tmp/passkey-browser",
        "./dist/-passkey-proof.html",
        "./src/-passkey-proof.html"
      ],
      "env": [
        "CHROME_BIN",
        "DENO_DIR"
      ],
      "net": [
        "127.0.0.1"
      ],
      "run": [
        "deno"
      ]
    },
    "passkey-browser": {
      "write": [
        "./.tmp/passkey-browser"
      ],
      "env": [
        "TMPDIR"
      ],
      "net": [
        "127.0.0.1"
      ]
    },
    "dev": {
      "read": true,
      "write": true,
      "run": true,
      "env": true,
      "net": true,
      "ffi": true,
      "sys": {
        "allow": [
          "cpus",
          "networkInterfaces",
          "hostname",
          "osRelease",
          "homedir",
          "uid",
          "gid"
        ]
      }
    }
  }
}

