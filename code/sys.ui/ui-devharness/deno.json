{
  "name": "@sys/ui-react-devharness",
  "version": "0.0.326",
  "license": "MIT",
  "tasks": {
    "dev": "deno run -P=dev   ./-scripts/task.main.ts --cmd=dev    --in=./src/index.html",
    "build": "deno run -P=dev ./-scripts/task.main.ts --cmd=build  --in=./src/index.html",
    "serve": "deno run -P=dev ./-scripts/task.main.ts --cmd=serve",
    "test": "deno test -P=test",
    "dry": "deno publish --allow-dirty --dry-run",
    "check": "deno check -- ./src/ ./-scripts/*",
    "clean": "deno run -P=clean ./-scripts/task.clean.ts",
    "info": "deno run -P=dev   ./-scripts/task.main.ts --cmd=info",
    "tmp": "deno run -A ./-scripts/task.tmp.ts"
  },
  "exports": {
    ".": "./src/mod.ts",
    "./t": "./src/types.ts",
    "./types": "./src/types.ts",
    "./react": "./src/m.react/mod.ts",
    "./react/t": "./src/m.react/types.ts",
    "./react/hooks": "./src/m.react/hooks.ts",
    "./react/spec": "./src/m.react/spec.ts",
    "./react/-test/entry-specs": "./src/m.react/-test/entry-specs.ts"
  },
  "permissions": {
    "clean": { "read": true, "write": true, "env": true },
    "test": { "read": true, "write": true, "env": true },
    "dev": {
      "read": true,
      "write": true,
      "run": true,
      "env": true,
      "net": true,
      "ffi": true,
      "sys": {
        "allow": ["cpus", "networkInterfaces", "hostname", "osRelease", "homedir", "uid", "gid"]
      }
    }
  }
}
