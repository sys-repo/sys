{
  "name": "@sys/tools",
  "version": "0.0.425",
  "license": "MIT",
  "tasks": {
    "test": "deno test -P=test ./-scripts ./src",
    "test:deploy": "deno test -P=test --trace-leaks ./src/cli.deploy",
    "test:pull": "deno test -P=test --trace-leaks ./src/cli.pull",
    "test:serve": "deno test -P=test --trace-leaks ./src/cli.serve",
    "dry": "deno publish --allow-dirty --dry-run",
    "check": "deno check src/*",
    "clean": "deno run -P=clean ./-scripts/task.clean.ts",
    "prep": "deno run -P=dev ./-scripts/task.prep.ts && deno run -P=dev ./src/-tmpl/mod.ts && deno task help:bundle",
    "tmpl": "deno run -P=dev ./src/-tmpl.cli/mod.ts",
    "help": "deno run -P=dev ./src/mod.ts --help",
    "tmp": "deno run -P=dev ./-scripts/task.tmp.ts",
    "help:bundle": "deno run -RWE ./src/m.help/-bundle/mod.ts"
  },
  "exports": {
    ".": "./src/mod.ts",
    "./t": "./src/types.ts",
    "./types": "./src/types.ts",
    "./cp": "./src/cli.clipboard/mod.ts",
    "./copy": "./src/cli.clipboard/mod.ts",
    "./pull": "./src/cli.pull/mod.ts",
    "./shell": "./src/cli.shell/mod.ts",
    "./pi": "./src/cli.pi/mod.ts",
    "./tmpl": "./src/cli.tmpl/mod.ts",
    "./crdt": "./src/cli.crdt/mod.ts",
    "./video": "./src/cli.video/mod.ts",
    "./serve": "./src/cli.serve/mod.ts",
    "./deploy": "./src/cli.deploy/mod.ts",
    "./up": "./src/cli.update/mod.ts",
    "./update": "./src/cli.update/mod.ts",
    "./update/advisory-probe": "./src/cli.update/u.advisory.probe.ts",
    "./env": "./src/-exports/-env.ts"
  },
  "permissions": {
    "clean": {
      "read": true,
      "write": true,
      "env": true
    },
    "test": {
      "read": true,
      "write": true,
      "env": true,
      "net": true,
      "run": true
    },
    "dev": {
      "read": true,
      "write": true,
      "run": true,
      "env": true,
      "net": true
    }
  }
}

