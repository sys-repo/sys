{
  "name": "@sys/model",
  "version": "0.0.116",
  "license": "MIT",
  "tasks": {
    "test": "deno test -P=test",
    "dry": "deno publish --allow-dirty --dry-run",
    "check": "deno check src/*",
    "clean": "deno run -P=clean ./-scripts/task.clean.ts",
    "tmp": "deno run -A ./-scripts/task.tmp.ts"
  },
  "exports": {
    ".": "./src/mod.ts",
    "./t": "./src/types.ts",
    "./types": "./src/types.ts",
    "./files": "./src/m.files/mod.ts",
    "./files/t": "./src/m.files/t.ts",
    "./files/fs": "./src/m.files.fs/mod.ts",
    "./files/fs/t": "./src/m.files.fs/t.ts",
    "./files/memory": "./src/m.files.memory/mod.ts",
    "./files/memory/t": "./src/m.files.memory/t.ts",
    "./files/static": "./src/m.files.static/mod.ts",
    "./files/static/t": "./src/m.files.static/t.ts",
    "./timecode/playback": "./src/m.timecode.playback/mod.ts",
    "./timecode/playback/t": "./src/m.timecode.playback/t.ts"
  },
  "permissions": {
    "clean": {
      "read": true,
      "write": true,
      "env": true
    },
    "test": {
      "read": true,
      "write": true,
      "env": true
    }
  }
}

