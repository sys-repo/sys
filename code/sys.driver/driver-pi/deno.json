{
  "name": "@sys/driver-pi",
  "version": "0.0.138",
  "license": "MIT",
  "tasks": {
    "test": "deno task test:unit && deno task test:profiles && deno task test:preview:real",
    "test:unit": "deno test -P=test ./src ./-scripts",
    "test:profiles": "deno test -P=test ./src/m.core/m.cli.profiles/-test && deno task test:profiles:process",
    "test:profiles:process": "deno test -P=test-process --trace-leaks ./src/m.core/m.cli.profiles/-test.external/-u.start.gui.exit.process-proof.ts",
    "test:preview": "deno test -P=test --trace-leaks ./-scripts/-test/-task.start.gui.preview.test.ts",
    "test:preview:real": "deno test -P=preview-test --no-prompt --deny-write=../../.. --trace-leaks ./-scripts/-test.external/-task.start.gui.preview.real.ts",
    "test:source:process": "deno run --no-prompt -P=source-process ./-scripts/-test.external/-task.start.gui.source.process-proof.ts",
    "test:browser": "deno task build && FORCE_COLOR=0 deno test -P=test-browser --trace-leaks ./-scripts/-test.browser.ts",
    "prep": "deno run -P=dev ./-scripts/task.prep.ts",
    "cli": "deno run -P=cli ./-scripts/task.cli.ts",
    "cli:raw": "deno run -P=cli ./src/m.core/m.cli.raw/mod.ts",
    "dev": "deno run -P=dev ./-scripts/task.vite.ts --cmd=dev --in=./src/index.html",
    "build": "deno run -P=dev ./-scripts/task.vite.ts --cmd=build --in=./src/index.html",
    "serve": "deno run -P=dev ./-scripts/task.vite.ts --cmd=serve",
    "reset": "deno task start:gui:reset",
    "start:gui:reset": "deno run -P=clean ./-scripts/task.start.gui.reset.ts",
    "start:gui:source": "deno run --no-prompt -P=source ./-scripts/task.start.gui.source.ts",
    "start:gui:preview": "deno run -P=preview-launch --no-prompt ./-scripts/task.start.gui.preview.ts",
    "dry": "deno publish --allow-dirty --dry-run",
    "check": "deno check -- ./src/ ./-scripts/*",
    "clean": "deno run -P=clean ./-scripts/task.clean.ts",
    "info": "deno run -P=dev ./-scripts/task.vite.ts --cmd=info",
    "tmp": "deno run -A ./-scripts/task.tmp.ts"
  },
  "exports": {
    ".": "./src/mod.ts",
    "./t": "./src/types.ts",
    "./types": "./src/types.ts",
    "./core": "./src/m.core/mod.ts",
    "./cli": "./src/m.core/m.cli/mod.ts",
    "./cli/raw": "./src/m.core/m.cli.raw/mod.ts"
  },
  "exclude": [".tmp", ".pi", "-agent", "-config"],
  "permissions": {
    "clean": { "read": true, "write": true, "env": true },
    "test": {
      "read": true,
      "write": true,
      "env": true,
      "net": ["localhost", "127.0.0.1", "0.0.0.0"]
    },
    "test-process": {
      "read": true,
      "run": ["deno"],
      "env": true
    },
    "test-process-child": {
      "read": true,
      "env": true
    },
    "source": {
      "read": ["./dist"],
      "net": ["127.0.0.1:8080"]
    },
    "source-process": {
      "read": ["./dist"],
      "net": ["localhost:8080", "127.0.0.1:8080"],
      "run": ["deno"]
    },
    "preview-launch": {
      "read": true,
      "env": ["DENO_DIR", "SystemRoot"],
      "run": ["deno"]
    },
    "preview-worker": {
      "read": true,
      "write": true,
      "env": true,
      "net": ["localhost", "127.0.0.1"],
      "run": ["deno", "open", "wslview", "xdg-open", "powershell.exe", "cmd.exe", "explorer.exe"]
    },
    "preview-build": {
      "read": true,
      "env": true,
      "run": ["deno"],
      "ffi": ["../../../node_modules/.deno"],
      "sys": {
        "allow": ["cpus", "networkInterfaces", "hostname", "osRelease", "homedir", "uid", "gid"]
      }
    },
    "preview-test": {
      "read": true,
      "write": true,
      "env": true,
      "net": ["localhost", "127.0.0.1"],
      "run": ["deno"]
    },
    "test-browser": {
      "read": true,
      "write": true,
      "env": true,
      "net": ["127.0.0.1", "0.0.0.0"],
      "run": true
    },
    "cli": {
      "read": true,
      "write": true,
      "run": true,
      "env": true,
      "net": ["localhost", "127.0.0.1", "0.0.0.0"]
    },
    "dev": {
      "read": true,
      "write": true,
      "run": true,
      "env": true,
      "net": true,
      "ffi": true,
      "sys": {
        "allow": ["cpus", "networkInterfaces", "hostname", "osRelease"]
      }
    }
  }
}
