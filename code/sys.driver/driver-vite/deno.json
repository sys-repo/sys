{
  "name": "@sys/driver-vite",
  "version": "0.0.480",
  "license": "MIT",
  "tasks": {
    "ci": "deno task check && deno task test && deno task test:proofs && deno task test:external && deno task clean",
    "prep": "deno run -P=dev ./-scripts/task.prep.ts",
    "dry": "deno publish --allow-dirty --dry-run",
    "check": "deno check --node-modules-dir=auto src/*",
    "test": "deno task test:unit",
    "test:cache": "deno run --node-modules-dir=auto -P=test --frozen --no-prompt ./-scripts/task.test.ts cache",
    "test:run": "deno test --node-modules-dir=auto -A --frozen --cached-only --no-prompt",
    "test:lane": "deno run --node-modules-dir=auto -P=test --frozen --cached-only --no-prompt ./-scripts/task.test.ts",
    "test:unit": "deno task test:lane unit",
    "test:proofs": "deno task test:lane proofs",
    "test:build": "deno task test:lane build",
    "test:bridge": "deno task test:lane bridge",
    "test:dev": "deno task test:lane dev",
    "test:config:process": "deno task test:lane config:process",
    "test:graph": "deno task test:lane graph",
    "test:loader": "deno task test:lane loader",
    "test:entry:process": "deno task test:lane entry:process",
    "test:candidate": "deno task test:lane candidate",
    "test:dist:pipeline": "deno task test:lane dist:pipeline",
    "test:external": "deno task test:lane external",
    "test:integrity:build": "deno task test:lane integrity:build",
    "test:integrity:apps": "deno task test:lane integrity:apps",
    "test:integrity": "deno task test:lane integrity",
    "perf": "deno run -A ./-scripts/task.perf.ts",
    "smoke": "deno run -P=dev ./-scripts/task.smoke.ts",
    "clean": "deno run -P=clean ./-scripts/task.clean.ts",
    "dev": "deno task sample:dev",
    "build": "deno task sample:build",
    "serve": "deno task sample:serve",
    "info": "deno task sample:info",
    "sample:dev": "deno run -A ./-scripts/task.main.ts --cmd=dev --dir=./src/-test/vite.sample-1",
    "sample:build": "deno run -A ./-scripts/task.main.ts --cmd=build --dir=./src/-test/vite.sample-1",
    "sample:serve": "deno run -P=dev ./-scripts/task.main.ts --cmd=serve --dir=./src/-test/vite.sample-1/dist",
    "sample:info": "deno run -A ./-scripts/task.main.ts --cmd=info --dir=./src/-test/vite.sample-1",
    "tmp": "deno run -A ./-scripts/task.tmp.ts"
  },
  "exports": {
    ".": "./src/mod.ts",
    "./config": "./src/m.vite.config/mod.ts",
    "./t": "./src/types.ts",
    "./entry": "./src/-entry/mod.ts",
    "./main": "./src/-entry/-main.ts",
    "./service": "./src/m.service/mod.ts",
    "./plugins": "./src/m.vite.plugins/mod.ts",
    "./sample-imports": "./src/-test/-sample-imports.ts"
  },
  "publish": {
    "exclude": [
      "src/-entry/-test.external",
      "src/-entry/-test.fixture",
      "src/-test/vite.sample-1/",
      "src/-test/vite.sample-2/",
      "src/-test/vite.sample-3/",
      "src/-test/vite.sample-config/",
      "src/-test/vite.sample-std-path/",
      "src/-test/vite.sample-bridge/",
      "src/-test/vite.sample-published-baseline/",
      "src/-test/vite.sample-published-ui-baseline/",
      "src/-test/vite.sample-published-ui-components/"
    ]
  },
  "permissions": {
    "clean": { "read": true, "write": true, "env": true },
    "entry-serve-proof": {
      "read": ["./.tmp/entry-serve-proof/dist"],
      "net": ["127.0.0.1:0"],
      "env": ["FORCE_COLOR", "TERM", "TERM_PROGRAM"]
    },
    "test": {
      "read": true,
      "write": true,
      "env": true,
      "net": true,
      "run": true,
      "ffi": true,
      "sys": {
        "allow": ["cpus", "networkInterfaces", "hostname", "osRelease", "homedir", "uid", "gid"]
      }
    },
    "dev": {
      "read": true,
      "write": true,
      "run": true,
      "env": true,
      "net": true,
      "ffi": true,
      "sys": {
        "allow": ["cpus", "networkInterfaces", "hostname", "osRelease", "homedir", "uid", "gid"]
      }
    }
  }
}
