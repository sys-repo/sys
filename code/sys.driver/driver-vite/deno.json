{
  "name": "@sys/driver-vite",
  "version": "0.0.475",
  "license": "MIT",
  "tasks": {
    "ci": "deno task check && deno task test && deno task test:external && deno task clean",
    "prep": "deno run -P=dev ./-scripts/task.prep.ts",
    "dry": "deno publish --allow-dirty --dry-run",
    "check": "deno check --node-modules-dir=auto src/*",
    "test": "deno task test:unit && deno task test:entry:process",
    "test:unit": "deno test --node-modules-dir=auto -P=test",
    "test:entry:process": "deno test --node-modules-dir=auto -P=test --trace-leaks ./src/-entry/-test.external/-graph.process.ts ./src/-entry/-test.external/-serve.cached.process.ts",
    "test:external": "deno task test:unit --trace-leaks ./src/m.vite/-test.external/mod.ts",
    "perf": "deno run -P=dev ./-scripts/task.perf.ts",
    "smoke": "deno run -P=dev ./-scripts/task.smoke.ts",
    "clean": "deno run -P=clean ./-scripts/task.clean.ts",
    "dev": "deno task sample:dev",
    "build": "deno task sample:build",
    "serve": "deno task sample:serve",
    "info": "deno task sample:info",
    "sample:dev": "deno run -P=dev ./-scripts/task.main.ts --cmd=dev --dir=./src/-test/vite.sample-1",
    "sample:build": "deno run -P=dev ./-scripts/task.main.ts --cmd=build --dir=./src/-test/vite.sample-1",
    "sample:serve": "deno run -P=dev ./-scripts/task.main.ts --cmd=serve --dir=./src/-test/vite.sample-1/dist",
    "sample:info": "deno run -P=dev ./-scripts/task.main.ts --cmd=info --dir=./src/-test/vite.sample-1",
    "tmp": "deno run -A ./-scripts/task.tmp.ts"
  },
  "exports": {
    ".": "./src/mod.ts",
    "./config": "./src/m.vite.config/mod.ts",
    "./t": "./src/types.ts",
    "./types": "./src/types.ts",
    "./entry": "./src/-entry/mod.ts",
    "./main": "./src/-entry/-main.ts",
    "./service": "./src/m.service/mod.ts",
    "./plugins": "./src/m.vite.plugins/mod.ts",
    "./sample-imports": "./src/-test/-sample-imports.ts"
  },
  "publish": {
    "exclude": [
      "src/-entry/-test.external",
      "src/-entry/-test.fixture"
    ]
  },
  "permissions": {
    "clean": {
      "read": true,
      "write": true,
      "env": true
    },
    "entry-serve-proof": {
      "read": [
        "./.tmp/entry-serve-proof/dist"
      ],
      "net": [
        "127.0.0.1:0"
      ],
      "env": [
        "FORCE_COLOR",
        "TERM",
        "TERM_PROGRAM"
      ]
    },
    "test": {
      "read": true,
      "write": true,
      "env": true,
      "net": true,
      "run": true,
      "ffi": true,
      "sys": {
        "allow": [
          "cpus",
          "networkInterfaces",
          "hostname",
          "osRelease",
          "homedir",
          "uid",
          "gid"
        ]
      }
    },
    "dev": {
      "read": true,
      "write": true,
      "run": true,
      "env": true,
      "net": true,
      "ffi": true,
      "sys": {
        "allow": [
          "cpus",
          "networkInterfaces",
          "hostname",
          "osRelease",
          "homedir",
          "uid",
          "gid"
        ]
      }
    }
  }
}

