{
  "name": "@sample/r2",
  "version": "0.0.3",
  "license": "MIT",
  "private": true,
  "tasks": {
    "test": "deno test -P=test ./src/-test/ ./-scripts/-test/",
    "proof:local": "deno run --no-prompt --unstable-no-legacy-abort -P=serve ./-scripts/task.proof.local.ts",
    "build": "deno run --no-prompt -P=build ./-scripts/task.build.ts",
    "clean": "deno run --no-prompt -P=clean ./-scripts/task.clean.ts",
    "push": "deno task push:public && deno task push:private && deno task push:next",
    "push:public": "deno run --no-prompt -P=push ./-scripts/task.push.ts public",
    "push:private": "deno run --no-prompt -P=push ./-scripts/task.push.ts private",
    "push:next": "deno run --no-prompt -P=push ./-scripts/task.push.next.ts",
    "serve": "deno run --no-prompt --unstable-no-legacy-abort -P=serve ./-scripts/task.serve.ts"
  },
  "exports": {
    ".": "./src/mod.ts",
    "./t": "./src/types.ts"
  },
  "permissions": {
    "clean": { "read": true, "write": true, "env": true },
    "test": {
      "read": true,
      "write": true,
      "env": true
    },
    "build": {
      "read": true,
      "write": true,
      "env": true,
      "run": [
        "deno"
      ],
      "sys": [
        "osRelease"
      ],
      "ffi": true
    },
    "push": {
      "read": true,
      "write": true,
      "env": true,
      "net": [
        "1e6ec0395407e49eef7ee54f667d61de.r2.cloudflarestorage.com:443"
      ]
    },
    "serve": {
      "read": true,
      "env": true,
      "net": [
        "127.0.0.1:8080",
        "1e6ec0395407e49eef7ee54f667d61de.r2.cloudflarestorage.com:443"
      ]
    }
  }
}
