# Keep sample Cell descriptors tracked despite the workspace-level `-config` ignore.
!-sample/-config/
!-sample/*/-config/
!-sample/*/-config/**

# Pi runtime state for sample launches is local and generated.
-sample/.pi/

# Pulled Cell view artifacts and local deploy outputs are managed outputs.
-sample/*/view/.pulled/
-sample/*/.tmp/

# Real deploy provider configs are operator-local.
-sample/*/-config/@sys.tools.deploy/orbiter.yaml

-sample/foo/
