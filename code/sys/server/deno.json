{
  "name": "@sys/server",
  "version": "0.0.42",
  "license": "MIT",
  "tasks": {
    "test": "deno test -P=test",
    "dry": "deno publish --allow-dirty --dry-run",
    "check": "deno check -- ./src/ ./-scripts/* ./-sample/files.ws/* ./-sample/files.http.cmd/* ./-sample/files.http.static/*",
    "clean": "deno run -P=clean ./-scripts/task.clean.ts",
    "prep": "deno task help:bundle",
    "help:bundle": "deno run -RWE ./src/m.help/-bundle/mod.ts",
    "sample": "deno run -P=sample ./-scripts/task.sample.ts",
    "sample:files:ws": "deno run -P=sample-files-tty ./-sample/files.ws/-start.ts",
    "sample:files:http:cmd": "deno run -P=sample-files-tty --allow-write ./-sample/files.http.cmd/-start.ts",
    "sample:files:http:static": "deno run -P=sample-files-tty ./-sample/files.http.static/-start.ts",
    "tmp": "deno run -A ./-scripts/task.tmp.ts"
  },
  "exports": {
    ".": "./src/mod.ts",
    "./t": "./src/types.ts",
    "./types": "./src/types.ts",
    "./websocket": "./src/m.server.websocket/mod.ts",
    "./files": "./src/m.server.files/mod.ts",
    "./files/service": "./src/m.server.files/m.Service/mod.ts",
    "./files/t": "./src/m.server.files/t.ts"
  },
  "permissions": {
    "clean": {
      "read": true,
      "write": true,
      "env": true
    },
    "test": {
      "read": true,
      "write": true,
      "env": true,
      "net": true,
      "run": true
    },
    "sample": {
      "read": true,
      "env": true,
      "run": true
    },
    "sample-files-tty": {
      "read": true,
      "env": true,
      "net": true,
      "run": [
        "sh"
      ]
    }
  }
}

