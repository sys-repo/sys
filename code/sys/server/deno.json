{
  "name": "@sys/server",
  "version": "0.0.8",
  "license": "MIT",
  "tasks": {
    "test": "deno test -P=test",
    "dry": "deno publish --allow-dirty --dry-run",
    "check": "deno check -- ./src/ ./-scripts/* ./-sample/files.websocket/* ./-sample/files.static/*",
    "clean": "deno run -P=clean ./-scripts/task.clean.ts",
    "prep": "deno task help:bundle",
    "help:bundle": "deno run -RWE ./src/m.help/-bundle/mod.ts",
    "sample:files": "deno task sample:files:ws",
    "sample:files:ws": "deno run -P=sample-files-ws ./-sample/files.websocket/-start.ts",
    "sample:files:static": "deno run -P=sample-files-static ./-sample/files.static/-start.ts",
    "tmp": "deno run -A ./-scripts/task.tmp.ts"
  },
  "exports": {
    ".": "./src/mod.ts",
    "./t": "./src/types.ts",
    "./types": "./src/types.ts",
    "./websocket": "./src/m.server.websocket/mod.ts",
    "./files": "./src/m.server.files/mod.ts",
    "./files/service": "./src/m.server.files/m.Service/mod.ts",
    "./files/t": "./src/m.server.files/t.ts"
  },
  "permissions": {
    "clean": {
      "read": true,
      "write": true,
      "env": true
    },
    "test": {
      "read": true,
      "write": true,
      "env": true,
      "net": true,
      "run": true
    },
    "sample-files-ws": {
      "read": true,
      "env": true,
      "net": true
    },
    "sample-files-static": {
      "read": true,
      "env": true,
      "net": true
    }
  }
}

